# Fill these in locally. Never send tokens in chat.
GUILD_ID=
PARTIK_TOKEN=
UTILITY_TOKEN=
ASSISTANCE_TOKEN=
# After inviting all three bots, enter Aerial Assistance's application/user ID.
ASSISTANCE_ID=
# Optional staff role ID; otherwise only administrators can manage tickets.
STAFF_ROLE_ID=
# Optional private channel for moderation notices (message contents aren't logged).
MOD_LOG_CHANNEL_ID=
# Comma-separated allowed advertising domains; subdomains are also allowed.
ALLOWED_DOMAINS=
# Optional comma-separated literal prohibited words/phrases.
BLOCKED_WORDS=
# AI is off until configured. Options: off, openai, ollama.
AI_PROVIDER=off
OPENAI_API_KEY=
OPENAI_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
# Only admins can enable AI for an individual ticket using /ai-enable.
AI_DAILY_LIMIT=100
DATA_DIR=./data
CLIENT_DOWNLOAD_URL=

# Optional image moderation (separate from generative support AI)
MODERATION_PROVIDER=openai
OPENAI_MODERATION_KEY=
MODERATION_DAILY_LIMIT=1000
